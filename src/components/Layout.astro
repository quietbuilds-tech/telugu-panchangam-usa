---
import type { Lang } from '@/i18n';
import { translations } from '@/i18n';

const { wide = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Build/data stamp: helps verify that a rebuild picked up the latest JSON changes.
let dataStamp: string | null = null;
try {
  const fs = await import('node:fs/promises');
  const url = new URL('../../data/2026-daysByDate.json', import.meta.url);
  const stat = await fs.stat(url);
  dataStamp = new Date(stat.mtimeMs).toISOString();
} catch {
  dataStamp = null;
}

const { title, description, activeTab, lang, canonicalPath, structuredData, ogImage, ogType = 'website', breadcrumbs } = Astro.props as {
  title: string;
  description?: string;
  activeTab: 'today' | 'month' | 'festivals' | 'about';
  lang: Lang;
  canonicalPath?: string;
  structuredData?: any[];
  ogImage?: string;
  ogType?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
};

const t = translations[lang];
const pathname = Astro.url.pathname;
const site = (import.meta.env.SITE || '').replace(/\/$/, '');
const canonical = canonicalPath ? `${site}${canonicalPath}` : (site ? `${site}${pathname}` : undefined);

// For hreflang alternates, strip the base prefix to get the route-relative path,
// then reconstruct with proper lang prefix.
const routePath = pathname.replace(new RegExp(`^${base}`), '');

// Default OG image
const defaultOgImage = `${site}/og-image.png`;
const ogImageUrl = ogImage || defaultOgImage;

// Generate breadcrumb structured data if breadcrumbs provided
const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.name,
    "item": `${site}${crumb.url}`
  }))
} : null;

// WebSite schema with search action
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": t.brandTitle,
  "url": site,
  "description": lang === 'te'
    ? "న్యూజెర్సీ (ఈస్ట్రన్ టైమ్) కోసం రోజువారీ తెలుగు పంచాంగం - తిథి, నక్షత్రం, పండుగలు"
    : "Daily Telugu Panchangam for New Jersey (Eastern Time) - Tithi, Nakshatra, Festivals",
  "inLanguage": lang,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${site}/${lang}/date/{date}/`
    },
    "query-input": "required name=date"
  }
};

// Organization schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": t.brandTitle,
  "url": site,
  "logo": `${site}/logo.png`,
  "image": `${site}/og-image.png`,
  "description": lang === 'te'
    ? "తెలుగు పంచాంగం USA - న్యూజెర్సీ ఈస్ట్రన్ టైమ్ కోసం ఖచ్చితమైన హిందూ క్యాలెండర్"
    : "Telugu Panchangam USA - Accurate Hindu Calendar for New Jersey Eastern Time"
};

// Combine all schemas
const allSchemas = [
  websiteSchema,
  organizationSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(structuredData || [])
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}

    <!-- Open Graph meta tags -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={t.brandTitle} />
    <meta property="og:locale" content={lang === 'te' ? 'te_IN' : 'en_US'} />

    <!-- Twitter Card meta tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description ? <meta name="twitter:description" content={description} /> : null}
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Additional SEO meta tags -->
    <meta name="keywords" content={t.seo.keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content={lang === 'te' ? 'Telugu' : 'English'} />
    <meta name="geo.region" content="US-NJ" />
    <meta name="geo.placename" content="New Jersey" />
    <meta name="author" content={t.brandTitle} />

    <!-- Fonts: system UI (English) + Anek Telugu (Telugu script) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anek+Telugu:wght@400;600;700&display=swap" rel="stylesheet" />

    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {site ? <link rel="alternate" hreflang="en" href={`${site}${base}${routePath.replace(/^\/(en|te)/, '/en')}`} /> : null}
    {site ? <link rel="alternate" hreflang="te" href={`${site}${base}${routePath.replace(/^\/(en|te)/, '/te')}`} /> : null}
    {site ? <link rel="alternate" hreflang="x-default" href={`${site}${base}/en/today/`} /> : null}
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="stylesheet" href={`${base}/styles.css`} />

    <!-- Structured Data (JSON-LD) -->
    {allSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="header-top">
          <div class="brand">
            <a href={`${base}/${lang}/today/`} class="brand__title">{t.brandTitle}</a>
            <div class="brand__sub">{t.locationSub}</div>
          </div>

          <div class="lang-toggle" role="group" aria-label="Language">
            <a
              class={lang === 'en' ? 'lang-toggle__btn is-active' : 'lang-toggle__btn'}
              href={`${base}${routePath.replace(/^\/(en|te)/, '/en')}`}
              data-lang-link="en"
            >EN</a>
            <a
              class={lang === 'te' ? 'lang-toggle__btn is-active' : 'lang-toggle__btn'}
              href={`${base}${routePath.replace(/^\/(en|te)/, '/te')}`}
              data-lang-link="te"
            >అ</a>
          </div>
        </div>

        <nav class="tabs" aria-label="Primary">
          <a class={activeTab === 'today' ? 'tab tab--active' : 'tab'} href={`${base}/${lang}/today/`}>{t.nav.today}</a>
          <a class={activeTab === 'month' ? 'tab tab--active' : 'tab'} href={`${base}/${lang}/month/2026-02/`}>{t.nav.month}</a>
          <a class={activeTab === 'festivals' ? 'tab tab--active' : 'tab'} href={`${base}/${lang}/festivals/2026/`}>{t.nav.festivals}</a>
          <a class={activeTab === 'about' ? 'tab tab--active' : 'tab'} href={`${base}/${lang}/about/`}>{t.nav.about}</a>
        </nav>
      </div>
    </header>

    <main class={`container ${wide ? "container--wide" : ""}`}>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <small>
          © {new Date().getFullYear()} {t.brandTitle} • {t.common.timesInET}
          {dataStamp ? <span> • Data updated: {dataStamp}</span> : null}
        </small>
      </div>
    </footer>

    <script is:inline>
      // Remember language preference, but keep SEO-friendly URLs.
      (() => {
        const links = Array.from(document.querySelectorAll('[data-lang-link]'));
        links.forEach((a) => {
          a.addEventListener('click', () => {
            try { localStorage.setItem('tp_lang', a.getAttribute('data-lang-link')); } catch {}
          });
        });
      })();
    </script>
  </body>
</html>
